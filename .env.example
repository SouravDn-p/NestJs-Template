# App
PORT=5000
NODE_ENV=development

# PostgreSQL (local Nest / Prisma CLI → host 5432)
# App in Docker Compose: overridden to host "postgres" and db nest_template
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_template?schema=public

# JWT (shared by every role)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (optional — uploads fail without these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
